PUBLIC_UMAMI_URL=https://umami.loveheatrelationship.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_CONVERTKIT_FORM_ID=
GITHUB_TOKEN=
# Required at runtime for on-demand post/home routes (ISR).
DATABASE_URL=
# Vercel ISR on-demand revalidation (see apps/lhr-office revalidate.ts).
ISR_BYPASS_TOKEN=
# Signed draft preview links (/preview/[id]).
PREVIEW_TOKEN_SECRET=
KEEPA_API_KEY=
AMAZON_ASSOCIATES_TAG=
SERPAPI_KEY=

# Used by apps/lhr-office for admin auth (Supabase Auth). VITE_-prefixed vars are exposed to the
# client bundle by Vite. SUPABASE_URL is server-only, used to fetch the project's JWKS
# (https://.../auth/v1/.well-known/jwks.json) to verify the client's ES256-signed session token
# on every /api/* request — Supabase issues session tokens with per-project asymmetric signing
# keys, not a shared secret, so this can't be a static value like SUPABASE_JWT_SECRET was.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=

# Airlie Job Bus (office BFF → hub). Server-only; never VITE_*.
# Required for Studio enqueue and for cadence/MCP LLM calls (@lhr/llm → kind=llm).
# AIRLIE_HUB_URL=https://airlie-hub.vercel.app/api/v1
# AIRLIE_HUB_TENANT_KEY=  # value for "lhr" in hub TENANT_SERVICE_KEYS
