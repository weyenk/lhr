---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostTag from '../components/PostTag.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SidebarPostCard from '../components/SidebarPostCard.astro';
import { countPublished, getPublishedPostsPage } from '../lib/posts';

export const prerender = false;

const HERO_HEIGHT_PX = 655;
const CARD_HEIGHT_PX = 200;
const SIDEBAR_ITEM_HEIGHT_PX = 380;
const CARDS_PER_PAGE = 5;

const totalPublished = await countPublished();
const allPosts = totalPublished > 0 ? await getPublishedPostsPage(0, totalPublished) : [];
const [hero, ...cardPosts] = allPosts;

const lastPage = Math.max(1, Math.ceil(cardPosts.length / CARDS_PER_PAGE));

const rawPage = Astro.params.page;
let currentPage = 1;
if (rawPage) {
  const segment = rawPage.replace(/\/$/, '');
  if (!/^\d+$/.test(segment)) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  currentPage = Number.parseInt(segment, 10);
}

if (currentPage < 1 || currentPage > lastPage) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const offset = (currentPage - 1) * CARDS_PER_PAGE;
const pageData = cardPosts.slice(offset, offset + CARDS_PER_PAGE);

const isFirstPage = currentPage === 1;
const mainColumnHeight = (isFirstPage ? HERO_HEIGHT_PX : 0) + pageData.length * CARD_HEIGHT_PX;
const sidebarCount = Math.max(1, Math.round(mainColumnHeight / SIDEBAR_ITEM_HEIGHT_PX));
const sidebarOffset = offset + pageData.length;
const sidebarPosts = cardPosts.slice(sidebarOffset, sidebarOffset + sidebarCount);
const pageNumbers = Array.from({ length: lastPage }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? '/' : `/${n}/`);
const prevPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < lastPage ? currentPage + 1 : null;
---
<BaseLayout title={isFirstPage ? 'Love Heat Relationship' : `Love Heat Relationship — Page ${currentPage}`}>
  <div class="mx-auto max-w-[1200px] px-4 py-8">
    <h1 class="sr-only">Love Heat Relationship</h1>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
      <div class="md:col-span-8">
        {isFirstPage && hero && (
          <a
            href={`/posts/${hero.id}/`}
            class="home__featured mb-6 block rounded-lg bg-white p-4 shadow-md"
          >
            <img
              src={hero.data.coverPhoto}
              alt={hero.data.coverPhotoAlt}
              class="mb-3 aspect-[3/2] w-full rounded-md object-cover"
            />
            <PostTag type={hero.data.type} />
            <h2 class="mt-1 font-heading text-xl font-bold text-text">{hero.data.title}</h2>
          </a>
        )}
        <div class="home__cards flex flex-col gap-6">
          {pageData.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
        <nav class="home__pagination mt-6 flex items-center justify-center gap-4 text-sm font-medium" aria-label="Pagination">
          {prevPage ? (
            <a href={pageHref(prevPage)} class="text-text hover:text-accent">‹ Prev</a>
          ) : (
            <span class="text-accent-secondary">‹ Prev</span>
          )}
          <ul class="flex gap-2">
            {pageNumbers.map((n) => (
              <li>
                <a
                  href={pageHref(n)}
                  aria-current={n === currentPage ? 'page' : undefined}
                  class={n === currentPage ? 'font-bold text-accent' : 'text-text hover:text-accent'}
                >{n}</a>
              </li>
            ))}
          </ul>
          {nextPage ? (
            <a href={pageHref(nextPage)} class="text-text hover:text-accent">Next ›</a>
          ) : (
            <span class="text-accent-secondary">Next ›</span>
          )}
        </nav>
      </div>
      <div class="home__sidebar hidden md:block md:col-span-4">
        <h2 class="mb-4 font-heading text-sm font-bold uppercase tracking-wide text-accent-secondary">Latest</h2>
        <ul class="home__recent-list space-y-6">
          {sidebarPosts.map((post) => (
            <li class="home__recent-item">
              <SidebarPostCard post={post} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
