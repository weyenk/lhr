---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
---
<BaseLayout title="Community — Love Heat Relationship">
  <div class="community-page mx-auto max-w-[1200px] px-4 py-8 text-center">
    <h1 class="mb-2 font-heading text-2xl font-bold text-text">Coming soon</h1>
    <p class="mx-auto mb-6 max-w-[480px] text-sm leading-relaxed text-muted">
      A community space is on the way. In the meantime, sign up below to hear about new recipes and articles first.
    </p>
    <div class="mx-auto max-w-[420px] text-left">
      <EmailSignup variant="standalone" />
    </div>
  </div>
</BaseLayout>
