---
import { formatPrice } from '../lib/content';
import type { ProductData } from '../content/schemas';

interface Props {
  id: string;
  data: ProductData;
}

const { id, data } = Astro.props;
---
<a
  class="product-card block border border-hairline-surface bg-surface p-3 transition-colors hover:border-accent"
  href={data.vendorUrl}
  target="_blank"
  rel="noopener sponsored"
  data-umami-event="kitchenware-click"
  data-umami-event-product={id}
>
  <img src={data.image} alt={data.imageAlt} class="mb-2 aspect-[4/3] w-full object-cover" />
  <span class="product-card__name block font-heading text-sm font-medium text-ink">{data.name}</span>
  <span class="product-card__price block text-sm font-bold text-accent-deep">{formatPrice(data.priceCents)}</span>
</a>
