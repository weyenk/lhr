---
import type { AffiliateLinkData } from '../content/schemas';

interface Props {
  id: string;
  data: AffiliateLinkData;
}

const { id, data } = Astro.props;
---
<a
  class="affiliate-link block border border-hairline-surface bg-surface p-3 transition-colors hover:border-accent"
  href={data.url}
  target="_blank"
  rel="noopener sponsored"
  data-umami-event="affiliate-click"
  data-umami-event-link={id}
>
  {data.image && (
    <img src={data.image} alt={data.imageAlt} class="mb-2 aspect-[4/3] w-full object-cover" />
  )}
  <span class="affiliate-link__label block font-heading text-sm font-medium text-ink">{data.label}</span>
  <span class="affiliate-link__cue block text-xs font-bold text-accent-deep">Shop now →</span>
</a>
