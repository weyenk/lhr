{
  "name": "lhr-site",
  "private": true,
  "type": "module",
  "workspaces": [
    "mcp-server",
    "packages/schemas",
    "packages/jobs",
    "packages/db",
    "packages/llm",
    "apps/lhr-office"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@lhr/llm && npm run build --workspace=@lhr/schemas && npm run build --workspace=mcp-server && npm run build --workspace=@lhr/jobs && npm run build --workspace=@lhr/db",
    "dev": "astro dev",
    "dev:office": "cd apps/lhr-office && npm run dev",
    "build": "astro build",
    "preview": "astro preview",
    "pretest": "astro sync && mkdir -p .astro && cp node_modules/.astro/data-store.json .astro/data-store.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@lhr/schemas": "*",
    "astro": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
